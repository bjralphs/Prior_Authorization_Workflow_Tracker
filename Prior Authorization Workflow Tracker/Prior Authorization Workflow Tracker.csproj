<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Prior_Authorization_Workflow_Tracker</RootNamespace>
    <AssemblyName>Prior_Authorization_Workflow_Tracker</AssemblyName>
    <!-- Compress output so GitHub Pages serves smaller .br / .gz files -->
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor WebAssembly host -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.4" />
    <!-- Authorization components (AuthorizeView, AuthenticationStateProvider, etc.) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.4" />
    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <!-- Reporting / Export -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>

</Project>
