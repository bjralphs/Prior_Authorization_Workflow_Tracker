@implements IDisposable
@inject ToastService ToastSvc

@* Toast notification container — placed once in MainLayout.razor (§16.2) *@
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    @foreach (var toast in ToastSvc.Messages)
    {
        <div class="toast show align-items-center text-bg-@ToastClass(toast.Level) border-0 mb-2"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @toast.Message
                    @if (toast.LinkText is not null && toast.LinkUrl is not null)
                    {
                        <a href="@toast.LinkUrl" class="toast-link ms-2 fw-semibold">@toast.LinkText</a>
                    }
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick="() => ToastSvc.Dismiss(toast.Id)"
                        aria-label="Close"></button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
        => ToastSvc.OnChange += StateHasChangedSafe;

    public void Dispose()
        => ToastSvc.OnChange -= StateHasChangedSafe;

    private void StateHasChangedSafe() => InvokeAsync(StateHasChanged);

    private static string ToastClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "success",
        ToastLevel.Warning => "warning",
        ToastLevel.Error   => "danger",
        _                  => "info",
    };
}
