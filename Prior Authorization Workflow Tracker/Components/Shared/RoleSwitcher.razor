@using Prior_Authorization_Workflow_Tracker.Constants
@using Prior_Authorization_Workflow_Tracker.Services.Demo
@inject DemoSessionState Session
@inject DemoDataStore Store
@implements IDisposable

<div id="role-switcher" class="demo-banner">
    <span class="demo-banner-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        Demo Mode
    </span>
    <span class="demo-banner-sep">|</span>
    <span class="demo-banner-persona">Viewing as:</span>
    <select class="demo-banner-select" value="@_currentUserId" @onchange="OnRoleChanged">
        @foreach (var group in _groups)
        {
            <optgroup label="@group.Key">
                @foreach (var u in group.Value)
                {
                    <option value="@u.Id">@u.FullName (@u.Role)</option>
                }
            </optgroup>
        }
    </select>
    <span class="demo-banner-email text-muted">@_currentEmail</span>
</div>

<style>
    .demo-banner {
        position: sticky;
        top: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .35rem 1rem;
        background: #1a1a2e;
        color: #e0e0e0;
        font-size: .8rem;
        box-shadow: 0 2px 6px rgba(0,0,0,.3);
    }
    .demo-banner-label {
        font-weight: 600;
        color: #f5c518;
        white-space: nowrap;
    }
    .demo-banner-sep  { color: #555; }
    .demo-banner-persona { color: #aaa; white-space: nowrap; }
    .demo-banner-select {
        background: #2a2a4a;
        color: #fff;
        border: 1px solid #444;
        border-radius: 4px;
        padding: .15rem .4rem;
        font-size: .8rem;
        cursor: pointer;
        max-width: 260px;
    }
    .demo-banner-select:focus { outline: none; border-color: #7c7cff; }
    .demo-banner-email {
        font-size: .75rem;
        color: #888;
        display: none;
    }
    @@media (min-width: 640px) { .demo-banner-email { display: inline; } }
</style>

@code {
    private string _currentUserId = string.Empty;
    private string _currentEmail  = string.Empty;
    private Dictionary<string, List<DemoUser>> _groups = [];

    protected override void OnInitialized()
    {
        _groups = Store.Users
            .GroupBy(u => u.Role)
            .OrderBy(g => RoleOrder(g.Key))
            .ToDictionary(g => g.Key, g => g.ToList());

        Refresh();
        Session.OnChange += OnSessionChanged;
    }

    private void Refresh()
    {
        _currentUserId = Session.CurrentUserId;
        var u = Store.Users.FirstOrDefault(u => u.Id == _currentUserId);
        _currentEmail = u?.Email ?? string.Empty;
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? string.Empty;
        Session.SwitchTo(id);
    }

    private void OnSessionChanged()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    private static int RoleOrder(string role) => role switch
    {
        Roles.Specialist    => 0,
        Roles.Provider      => 1,
        Roles.Reviewer      => 2,
        Roles.BillingManager=> 3,
        Roles.Admin         => 4,
        _                   => 99,
    };

    public void Dispose() => Session.OnChange -= OnSessionChanged;
}
