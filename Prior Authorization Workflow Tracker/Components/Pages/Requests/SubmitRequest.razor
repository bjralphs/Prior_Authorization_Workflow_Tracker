@page "/requests/new"
@attribute [Authorize(Roles = "Authorization Specialist,Administrator")]
@inject IPaRequestService PaRequestSvc
@inject IWorkflowService WorkflowSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ToastService Toast
@inject ILogger<SubmitRequest> Logger
@using Prior_Authorization_Workflow_Tracker.Data
@using Prior_Authorization_Workflow_Tracker.Exceptions
@using Microsoft.EntityFrameworkCore

<PageTitle>Submit Request — PA Tracker</PageTitle>
<Breadcrumb Items="@(new[] { ("Dashboard", "/"), ("Request Queue", "/requests"), ("New Request", (string?)null) })" />

<h4 class="mb-4">Submit New Prior Authorization Request</h4>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    @* ── Patient Information ───────────────────────────────── *@
                    <h6 class="text-muted mb-3">Patient Information</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Patient MRN <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.PatientMrn" placeholder="e.g. MRN-0001" />
                            <ValidationMessage For="() => _model.PatientMrn" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Patient Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.PatientName" placeholder="Last, First" />
                            <ValidationMessage For="() => _model.PatientName" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
                            <input type="date" class="form-control @(_dobError is not null ? "is-invalid" : "")"
                                   value="@_dobStr"
                                   @onchange="e => ParseDob(e.Value?.ToString())" />
                            @if (_dobError is not null)
                            {
                                <div class="invalid-feedback">@_dobError</div>
                            }
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Diagnosis Code (ICD-10) <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.DiagnosisCode" placeholder="e.g. M17.11" />
                            <ValidationMessage For="() => _model.DiagnosisCode" class="text-danger small" />
                        </div>
                    </div>

                    <hr />

                    @* ── Clinical Information ──────────────────────────────── *@
                    <h6 class="text-muted mb-3">Clinical Information</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Insurance Plan <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_model.InsurancePlanID">
                                <option value="0">— Select plan —</option>
                                @foreach (var plan in _insurancePlans)
                                {
                                    <option value="@plan.ID">@plan.PlanName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _model.InsurancePlanID" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Procedure Code <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_model.ProcedureCodeID">
                                <option value="0">— Select procedure —</option>
                                @foreach (var code in _procedureCodes)
                                {
                                    <option value="@(code.ID)">@(code.Code) — @(code.Description)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _model.ProcedureCodeID" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Treating Provider <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_model.ProviderID">
                                <option value="">— Select provider —</option>
                                @foreach (var p in _providers)
                                {
                                    <option value="@p.Id">@(p.FullName ?? p.Email ?? p.Id)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _model.ProviderID" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Units Requested <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.ApprovedUnitsRequested" min="1" max="999" />
                            <ValidationMessage For="() => _model.ApprovedUnitsRequested" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Priority</label>
                        <InputSelect class="form-select" @bind-Value="_model.Priority">
                            @foreach (var p in Enum.GetValues<PaPriority>())
                            {
                                <option value="@p">@p</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            Clinical Justification <span class="text-danger">*</span>
                            <span class="text-muted small">(minimum 50 characters for submission)</span>
                        </label>
                        <InputTextArea class="form-control" rows="5" @bind-Value="_model.ClinicalJustification"
                                       placeholder="Describe the medical necessity..." />
                        <div class="text-muted small mt-1">@(_model.ClinicalJustification?.Length ?? 0) characters</div>
                        <ValidationMessage For="() => _model.ClinicalJustification" class="text-danger small" />
                    </div>

                    @* ── Error message ─────────────────────────────────────── *@
                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2">@_errorMessage</div>
                    }

                    @* ── Actions ───────────────────────────────────────────── *@
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary"
                                @onclick="SaveDraftAsync" disabled="@_saving">
                            @if (_saving && !_submitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save as Draft
                        </button>

                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_submitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Submit for Review
                        </button>

                        <a href="/requests" class="btn btn-link ms-auto">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    @* ── Sidebar hints ─────────────────────────────────────────────────────── *@
    <div class="col-lg-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">Submission Requirements</div>
            <div class="card-body small">
                <p class="mb-2"><strong>Minimum for draft save:</strong></p>
                <ul class="mb-3">
                    <li>Patient MRN</li>
                    <li>Insurance Plan</li>
                    <li>Procedure Code</li>
                </ul>
                <p class="mb-2"><strong>Required to submit:</strong></p>
                <ul class="mb-0">
                    <li>All draft fields</li>
                    <li>Patient Name &amp; Date of Birth</li>
                    <li>Treating Provider</li>
                    <li>Diagnosis Code (ICD-10)</li>
                    <li>Clinical Justification (≥ 50 chars)</li>
                    <li>Units Requested (1–999)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly CreatePaRequestModel _model = new();
    private string _dobStr = string.Empty;
    private string? _dobError;

    private List<InsurancePlan> _insurancePlans = [];
    private List<ProcedureCode> _procedureCodes = [];
    private List<ApplicationUser> _providers = [];

    private bool _saving;
    private bool _submitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _insurancePlans = await db.InsurancePlans
            .Where(p => p.IsActive)
            .OrderBy(p => p.PlanName)
            .AsNoTracking()
            .ToListAsync();
        _procedureCodes = await db.ProcedureCodes
            .Where(p => p.RequiresPriorAuth && p.IsActive)
            .OrderBy(p => p.Code)
            .AsNoTracking()
            .ToListAsync();

        // Load active Treating Provider accounts for the dropdown (T-B1 / BUG-G).
        // Join AspNetUserRoles → AspNetRoles to filter by role name without UserManager.
        var providerRoleId = await db.Roles
            .Where(r => r.Name == Prior_Authorization_Workflow_Tracker.Constants.Roles.Provider)
            .Select(r => r.Id)
            .FirstOrDefaultAsync();

        if (providerRoleId is not null)
        {
            var providerIds = await db.UserRoles
                .Where(ur => ur.RoleId == providerRoleId)
                .Select(ur => ur.UserId)
                .ToListAsync();

            _providers = await db.Users
                .Where(u => providerIds.Contains(u.Id) && u.IsActive)
                .OrderBy(u => u.FullName)
                .AsNoTracking()
                .ToListAsync();
        }
    }

    private void ParseDob(string? value)
    {
        _dobStr = value ?? string.Empty;
        if (DateTime.TryParse(value, out var dt))
        {
            _model.PatientDob = dt;
            _dobError = null;
        }
        else
        {
            _model.PatientDob = default;
            _dobError = string.IsNullOrEmpty(value) ? null : "Enter a valid date.";
        }
    }

    // ── Save Draft ────────────────────────────────────────────────────────────
    private async Task SaveDraftAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_model.PatientMrn) ||
            _model.InsurancePlanID == 0 ||
            _model.ProcedureCodeID == 0)
        {
            _errorMessage = "Patient MRN, Insurance Plan, and Procedure Code are required to save a draft.";
            return;
        }

        _saving = true;
        try
        {
            var request = await PaRequestSvc.CreateDraftAsync(_model);
            Toast.ShowSuccess($"Draft saved — {request.RequestNumber}",
                linkText: "See request drafts",
                linkUrl: "/requests?status=Draft");
            Nav.NavigateTo($"/requests/{request.ID}/edit");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Draft save failed.");
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Submit for review ─────────────────────────────────────────────────────
    private async Task HandleSubmit()
    {
        _errorMessage = null;

        // Date of Birth is parsed outside the EditContext; validate manually.
        if (_model.PatientDob == default)
        {
            _dobError = "Date of birth is required.";
            return;
        }

        _saving = true;
        _submitting = true;
        try
        {
            // Create draft first, then submit in one workflow step
            var draft = await PaRequestSvc.CreateDraftAsync(_model);
            var submitted = await WorkflowSvc.SubmitAsync(draft.ID);
            Toast.ShowSuccess($"Request {submitted.RequestNumber} submitted for review.");
            Nav.NavigateTo($"/requests/{submitted.ID}");
        }
        catch (BusinessRuleViolationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Request submission failed.");
            _errorMessage = "Submission failed. Please check all fields and try again.";
        }
        finally
        {
            _saving = false;
            _submitting = false;
        }
    }
}
