    // ── CSV Export (FR-010) ───────────────────────────────────────────────────
    private async Task ExportCsvAsync()
    {
        _exporting = true;
        try
        {
            var filter = new PaRequestFilter { PageSize = int.MaxValue, Page = 1 };
            var (data, fileName) = await CsvExport.ExportRequestsAsync(filter);
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "text/csv", data);
            Toast.ShowSuccess($"Export downloaded: {fileName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV export failed.");
            Toast.ShowError("Export failed. Please try again.");
        }
        finally
        {
            _exporting = false;
        }
    }

    // ── Chart JS helpers ──────────────────────────────────────────────────────
    private async Task RenderActiveChartAsync()
    {
        switch (_activeTab)
        {
            case "status"         when _statusSummary.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-status",         BuildStatusChart());         break;
            case "denials"        when _denials.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-denials",        BuildDenialsChart());        break;
            case "volume"         when _volume.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-volume",         BuildVolumeChart());         break;
            case "turnaround"     when _turnaround.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-turnaround",     BuildTurnaroundChart());     break;
            case "providervolume" when _providerVolume.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-providervolume", BuildProviderVolumeChart()); break;
            case "approvalrate"   when _approvalRate.Count > 0:
                await JS.InvokeVoidAsync("renderChart", "chart-approvalrate",   BuildApprovalRateChart());   break;
        }
    }

    private static string StatusChartColor(PaStatus s) => s switch
    {
        PaStatus.Draft       => "rgba(108,117,125,0.80)",
        PaStatus.Submitted   => "rgba(13,110,253,0.80)",
        PaStatus.PendingInfo => "rgba(253,126,20,0.80)",
        PaStatus.UnderReview => "rgba(255,193,7,0.80)",
        PaStatus.Approved    => "rgba(25,135,84,0.80)",
        PaStatus.Denied      => "rgba(220,53,69,0.80)",
        PaStatus.Appealed    => "rgba(111,66,193,0.80)",
        PaStatus.Expired     => "rgba(73,80,87,0.80)",
        PaStatus.Withdrawn   => "rgba(173,181,189,0.80)",
        _                    => "rgba(0,0,0,0.50)",
    };

    private object BuildStatusChart() => new
    {
        type = "doughnut",
        data = new
        {
            labels   = _statusSummary.Select(r => r.Status.ToString()).ToArray(),
            datasets = new[]
            {
                new
                {
                    data            = _statusSummary.Select(r => r.Count).ToArray(),
                    backgroundColor = _statusSummary.Select(r => StatusChartColor(r.Status)).ToArray(),
                    borderWidth     = 1,
                }
            }
        },
        options = new
        {
            responsive          = true,
            maintainAspectRatio = false,
            plugins = new { legend = new { position = "right" } },
        }
    };

    private object BuildDenialsChart() => new
    {
        type = "bar",
        data = new
        {
            labels   = _denials.Select(r => r.ReasonCode).ToArray(),
            datasets = new[]
            {
                new
                {
                    label           = "Denials",
                    data            = _denials.Select(r => r.Count).ToArray(),
                    backgroundColor = "rgba(220,53,69,0.72)",
                    borderColor     = "rgba(220,53,69,1)",
                    borderWidth     = 1,
                }
            }
        },
        options = new
        {
            indexAxis           = "y",
            responsive          = true,
            maintainAspectRatio = false,
            plugins = new { legend = new { display = false } },
            scales  = new { x = new { beginAtZero = true, ticks = new { precision = 0 } } }
        }
    };

    private object BuildVolumeChart() => new
    {
        type = "line",
        data = new
        {
            labels   = _volume.Select(r => new DateTime(r.Year, r.Month, 1).ToString("MMM yy")).ToArray(),
            datasets = new object[]
            {
                new
                {
                    label           = "Submitted",
                    data            = _volume.Select(r => r.Submitted).ToArray(),
                    borderColor     = "rgba(13,110,253,0.9)",
                    backgroundColor = "rgba(13,110,253,0.12)",
                    fill            = true,
                    tension         = 0.35,
                    pointRadius     = 4,
                },
                new
                {
                    label           = "Approved",
                    data            = _volume.Select(r => r.Approved).ToArray(),
                    borderColor     = "rgba(25,135,84,0.9)",
                    backgroundColor = "rgba(25,135,84,0.12)",
                    fill            = true,
                    tension         = 0.35,
                    pointRadius     = 4,
                },
                new
                {
                    label           = "Denied",
                    data            = _volume.Select(r => r.Denied).ToArray(),
                    borderColor     = "rgba(220,53,69,0.9)",
                    backgroundColor = "rgba(220,53,69,0.12)",
                    fill            = true,
                    tension         = 0.35,
                    pointRadius     = 4,
                }
            }
        },
        options = new
        {
            responsive          = true,
            maintainAspectRatio = false,
            plugins = new { legend = new { position = "top" } },
            scales  = new { y = new { beginAtZero = true, ticks = new { precision = 0 } } }
        }
    };

    private object BuildTurnaroundChart() => new
