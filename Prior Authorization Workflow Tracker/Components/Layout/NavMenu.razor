@using Microsoft.AspNetCore.Components.Authorization
@using Prior_Authorization_Workflow_Tracker.Constants
@implements IDisposable
@inject IJSRuntime JS
@inject INotificationService NotifSvc
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

@* Non-scoped styles:
   1) NavLink renders <a> without the Blazor scope attribute, so .folder-link
      positioning must be non-scoped to apply to anchor elements.
   2) SVG <use> children never get the scope attribute, so paint-server rules
      (fill: url(#id)) must also be non-scoped to match them. *@
<style>
    .folder-link { position: absolute; top: 3px; left: 12px; width: 250px; height: 76px; display: block; text-decoration: none; color: var(--ink); z-index: 3; }
    .folder-link:focus { outline: none; }
    .folder-shape         { fill: url(#manilaGradient); stroke: rgba(120,76,23,.24); stroke-width: 1; }
    .folder-highlight     { fill: none; stroke: rgba(255,255,255,.24); stroke-width: 1; }
    .folder-bottom-shadow { fill: none; stroke: rgba(98,58,10,.12); stroke-width: 3; }
    .folder-pocket-shadow { fill: url(#pocketShadowGradient); opacity: .75; }
    .folder-grain         { fill: url(#paperGrain); opacity: .22; mix-blend-mode: multiply; }
</style>

@* Hidden SVG — defines all gradient/pattern/path IDs used by folder <use> references *@
<svg width="0" height="0" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
    <defs>
        <linearGradient id="manilaGradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#f5dfab" />
            <stop offset="55%"  stop-color="#efcc82" />
            <stop offset="100%" stop-color="#e4b460" />
        </linearGradient>
        <linearGradient id="pocketShadowGradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"   stop-color="rgba(96,58,12,0)" />
            <stop offset="55%"  stop-color="rgba(96,58,12,0.16)" />
            <stop offset="100%" stop-color="rgba(96,58,12,0)" />
        </linearGradient>
        <pattern id="paperGrain" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.45" fill="rgba(77,48,15,0.25)" />
            <circle cx="6" cy="5" r="0.35" fill="rgba(255,255,255,0.34)" />
            <circle cx="3" cy="7" r="0.35" fill="rgba(77,48,15,0.14)" />
        </pattern>
        <path id="folderFacePath"            d="M0 8 Q0 0 8 0 H314 C333 0 344 4 344 20 V31 C344 39 356 38 356 48 V108 H0 Z" />
        <path id="folderHighlightPath"       d="M8 1 H312 C331 1 342 5 342 20" />
        <path id="folderBottomShadowPath"    d="M6 106 H350" />
        <path id="folderPocketShadowPath"    d="M312 4 C329 5 340 9 340 20 V31 C340 42 352 39 352 48 V106 H322 C326 84 326 25 312 4 Z" />
        <path id="folderFacePathTall"        d="M0 8 Q0 0 8 0 H314 C333 0 344 4 344 20 V31 C344 39 356 38 356 48 V192 H0 Z" />
        <path id="folderBottomShadowPathTall" d="M6 190 H350" />
        <path id="folderPocketShadowPathTall" d="M312 4 C329 5 340 9 340 20 V31 C340 42 352 39 352 48 V190 H322 C326 84 326 25 312 4 Z" />
    </defs>
</svg>

